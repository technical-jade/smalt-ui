{
  "name": "@smalt-ui/nuxt",
  "version": "2.0.0",
  "description": "Nuxt module for @smalt-ui/core: component auto-import, styles, color mode",
  "license": "MIT",
  "author": "Stanislav Dyachenko",
  "homepage": "https://technical-jade.github.io/smalt-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technical-jade/smalt-ui.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/technical-jade/smalt-ui/issues"
  },
  "keywords": [
    "vue",
    "nuxt",
    "nuxt-module",
    "ui",
    "components",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prebuild": "nuxi prepare ./playground",
    "build": "nuxt-module-build build",
    "pretypecheck": "pnpm --filter @smalt-ui/core build && nuxi prepare ./playground",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@smalt-ui/core": "workspace:^",
    "reka-ui": "^2.10.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@smalt-ui/core": "workspace:*",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0"
  }
}
